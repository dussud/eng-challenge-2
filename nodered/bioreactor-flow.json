  {
    "id": "sim_fn",
    "type": "function",
    "z": "tab_bioreactor",
    "name": "Fake sensors",
    "func": "// Fake bioreactor: drifts each value toward its setpoint with noise.\n// Disable or delete this once the real ESP32 is publishing.\nconst sp = flow.get('sim_sp') || {\"temperature\": 30.0, \"ph\": 6.0, \"rpm\": 750.0};\nconst st = flow.get('sim_state') || Object.assign({}, sp);\nconst noise = {\"temperature\": 0.1, \"ph\": 0.02, \"rpm\": 10};\n// Topic prefix comes from the inject node's Topic field\nconst prefix = msg.topic.endsWith('/') ? msg.topic : msg.topic + '/';\nconst msgs = [];\nfor (const k of Object.keys(st)) {\n    st[k] += 0.2 * (sp[k] - st[k]) + (Math.random() - 0.5) * 2 * noise[k];\n    msgs.push({ topic: prefix + k,\n                 payload: { value: Math.round(st[k] * 100) / 100, ts: Date.now() } });\n}\nflow.set('sim_state', st);\nreturn [msgs];\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 630,
    "wires": [
      [
        "sim_out"
      ]
    ]
  },
