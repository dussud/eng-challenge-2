  {
    "id": "route_tele",
    "type": "function",
    "z": "tab_bioreactor",
    "name": "Route by parameter",
    "func": "// Topic is bioreactor/<team>/telemetry/<param>\nconst param = msg.topic.split('/').pop();\nconst order = [\"temperature\", \"ph\", \"rpm\"];\nconst idx = order.indexOf(param);\nif (idx === -1) return null;\n// Accept either {\"value\": 30.1} or a bare number\nlet v = (msg.payload !== null && typeof msg.payload === 'object')\n    ? msg.payload.value : msg.payload;\nv = Number(v);\nif (!Number.isFinite(v)) return null;\nconst out = new Array(order.length).fill(null);\nout[idx] = { topic: param, payload: v };\nreturn out;\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 140,
    "wires": [
      [
        "chart_temperature",
        "text_temperature"
      ],
      [
        "chart_ph",
        "text_ph"
      ],
      [
        "chart_rpm",
        "text_rpm"
      ]
    ]
  },
