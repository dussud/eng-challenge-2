  {
    "id": "sim_sp_fn",
    "type": "function",
    "z": "tab_bioreactor",
    "name": "Store setpoint",
    "func": "// Simulator listens to setpoints too, like the real ESP32 would.\nconst k = msg.topic.split('/').pop();\nconst sp = flow.get('sim_sp') || {\"temperature\": 30.0, \"ph\": 6.0, \"rpm\": 750.0};\nconst v = Number(msg.payload);\nif (k in sp && Number.isFinite(v)) { sp[k] = v; flow.set('sim_sp', sp); }\nreturn null;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 730,
    "wires": [
      []
    ]
